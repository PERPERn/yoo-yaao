---
/**
 * Label + control + hint + error. Wrap any control in the default slot and give it
 * id={id} and aria-describedby={`${id}-hint ${id}-error`} (drop -hint if there is no hint).
 * Input and Select already use Field when you pass them a `label`, so you rarely need it directly.
 * For radio/checkbox groups pass `group` to render a <fieldset>/<legend>.
 *
 * Error text lives in an element with id `${id}-error` (aria-live="polite"), so client
 * scripts can fill it: document.getElementById(`${id}-error`).textContent = '...'.
 */
interface Props {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  required?: boolean;
  optional?: boolean;   // shows "(optional)" instead of marking required fields
  group?: boolean;      // fieldset + legend for radio/checkbox groups
  hideLabel?: boolean;  // visually hidden but announced
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  label,
  hint,
  error,
  required = false,
  optional = false,
  group = false,
  hideLabel = false,
  class: className,
  ...rest
} = Astro.props;

const Wrapper = group ? 'fieldset' : 'div';
const describedBy = group ? [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ') : undefined;
---

<Wrapper
  class:list={['field', error && 'field--invalid', className]}
  aria-describedby={describedBy}
  {...rest}
>
  {
    group ? (
      <legend class:list={['field__label', hideLabel && 'sr-only']}>
        {label}
        {required && <span class="field__req" aria-hidden="true"> *</span>}
        {optional && <span class="field__opt"> (optional)</span>}
      </legend>
    ) : (
      <label for={id} class:list={['field__label', hideLabel && 'sr-only']}>
        {label}
        {required && <span class="field__req" aria-hidden="true"> *</span>}
        {optional && <span class="field__opt"> (optional)</span>}
      </label>
    )
  }
  {hint && <p id={`${id}-hint`} class="field__hint">{hint}</p>}
  <div class="field__control"><slot /></div>
  <p id={`${id}-error`} class="field__error" aria-live="polite">{error}</p>
</Wrapper>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    border: 0;
    padding: 0;
  }
  .field__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    padding: 0;
  }
  .field__req {
    color: var(--color-danger);
  }
  .field__opt {
    font-weight: var(--weight-regular);
    color: var(--color-ink-2);
  }
  .field__hint {
    margin-top: calc(var(--space-1) * -1);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .field__error {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-danger);
  }
  .field__error:empty {
    display: none;
  }
  .field__error:not(:empty)::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.15em;
    height: 1.15em;
    margin-top: 0.2em;
    border-radius: 50%;
    background: var(--color-danger);
    color: var(--color-surface);
    font-size: 0.8em;
    font-weight: var(--weight-bold);
    line-height: 1;
  }
</style>
