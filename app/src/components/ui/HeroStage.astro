---
/**
 * Mount point for the three.js hero (3D agent). Renders <div data-hero-3d> with a static,
 * on-palette illustration as the fallback (no WebGL, reduced motion, or while the model loads).
 *
 * Contract for the 3D script:
 *   - find  document.querySelector('[data-hero-3d]')
 *   - append its <canvas> inside (it is positioned to fill the stage)
 *   - set  el.dataset.ready = 'true'  once the first frame renders → the fallback fades out
 * Extra attributes (data-reveal, data-model="/models/x.glb") pass through.
 */
interface Props {
  label?: string;           // accessible description of the scene
  ratio?: string;           // CSS aspect-ratio, default 1 / 1
  class?: string;
  [key: string]: unknown;
}
const { label = 'Illustration: sun rising over Thai hills and a temple chedi', ratio = '1 / 1', class: className, ...rest } =
  Astro.props;
---

<div class:list={['hero-stage', className]} data-hero-3d style={`--ratio:${ratio}`} {...rest}>
  <svg class="hero-stage__fallback" viewBox="0 0 400 400" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
    <rect width="400" height="400" fill="var(--color-brand-tint)"></rect>
    <circle cx="150" cy="185" r="92" fill="var(--color-accent)"></circle>
    <path d="M0 300C70 255 130 285 195 255s140-15 205-55V400H0z" fill="var(--color-brand)" opacity=".55"></path>
    <g fill="var(--color-ink)">
      <path d="M279 112l-4 86h8z"></path>
      <rect x="270" y="196" width="18" height="12" rx="1"></rect>
      <path d="M252 276c0-36 11-56 27-64 16 8 27 28 27 64z"></path>
      <rect x="243" y="274" width="72" height="11" rx="1"></rect>
      <rect x="233" y="284" width="92" height="12" rx="1"></rect>
    </g>
    <path d="M0 340c90-38 190-30 280-48 50-10 85-22 120-32V400H0z" fill="var(--color-brand)"></path>
  </svg>
</div>

<style>
  .hero-stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio, 1 / 1);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-brand-tint);
    isolation: isolate;
  }
  .hero-stage__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  .hero-stage[data-ready='true'] .hero-stage__fallback {
    opacity: 0;
  }
  .hero-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    z-index: 1;
  }
</style>
