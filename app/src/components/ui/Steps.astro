---
/**
 * Numbered steps as a real <ol>. Items are strings or { title, body }.
 * Layout: vertical (default, for how-to-apply) or horizontal (3–4 short steps on wide screens).
 */
type Step = string | { title: string; body?: string };
interface Props {
  items: Step[];
  layout?: 'vertical' | 'horizontal';
  start?: number;
  class?: string;
  [key: string]: unknown;
}
const { items, layout = 'vertical', start = 1, class: className, ...rest } = Astro.props;
const steps = items.map((s) => (typeof s === 'string' ? { title: s, body: undefined } : s));
---

<ol class:list={['steps', `steps--${layout}`, className]} start={start} style={`--start:${start - 1}`} {...rest}>
  {
    steps.map((s) => (
      <li class="steps__item">
        <div class="steps__content">
          <p class="steps__title">{s.title}</p>
          {s.body && <p class="steps__body">{s.body}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step var(--start, 0);
    display: grid;
    gap: var(--space-6);
  }
  .steps__item {
    counter-increment: step;
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .steps__item::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
  }
  /* connector between vertical steps: a soft filled track, not a hairline */
  .steps--vertical .steps__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(1.25rem - 2px);
    top: 2.75rem;
    bottom: calc(var(--space-6) * -1 + 0.25rem);
    width: 4px;
    border-radius: 2px;
    background: var(--color-brand-tint);
  }
  .steps__content {
    padding-top: 0.45rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .steps__title {
    font-weight: var(--weight-semibold);
    line-height: 1.4;
  }
  .steps__body {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }
  @media (min-width: 52rem) {
    .steps--horizontal {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: var(--space-8);
    }
    .steps--horizontal .steps__item {
      grid-template-columns: 1fr;
    }
    .steps--horizontal .steps__content {
      padding-top: 0;
    }
  }
</style>
