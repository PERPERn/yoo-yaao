---
/**
 * Inline SVG icon set (24px grid, 1.75 stroke, currentColor).
 * Decorative by default (aria-hidden). Pass `label` when the icon carries meaning on its own.
 */
export const ICONS = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  alert:
    '<path d="M12 3.5L2.8 19.5h18.4L12 3.5z"/><path d="M12 10v4.5"/><path d="M12 17.25v.01"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><path d="M12 7.75v.01"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  'map-pin':
    '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  passport:
    '<rect x="5" y="2.75" width="14" height="18.5" rx="2"/><circle cx="12" cy="10" r="3.25"/><path d="M8.75 10h6.5"/><path d="M12 6.75c-1 .9-1.4 2-1.4 3.25s.4 2.35 1.4 3.25c1-.9 1.4-2 1.4-3.25s-.4-2.35-1.4-3.25z"/><path d="M9 17h6"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.75 5.6 3.75 9S14.5 18.4 12 21c-2.5-2.6-3.75-5.6-3.75-9S9.5 5.6 12 3z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  star: '<path d="M12 3.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.65l5.9-.85L12 3.5z"/>',
  'arrow-right': '<path d="M4.5 12h15"/><path d="M13.5 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17L17 7"/><path d="M8.5 7H17v8.5"/>',
  'chevron-down': '<path d="M6 9.5l6 6 6-6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  x: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  shield:
    '<path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.2-7.5 9.5-4.4-1.3-7.5-4.9-7.5-9.5V6L12 3z"/><path d="M8.75 12l2.25 2.25 4.25-4.5"/>',
  users:
    '<circle cx="9" cy="8.5" r="3.25"/><path d="M3 19.5c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><path d="M15.5 5.5a3.25 3.25 0 010 6"/><path d="M17.5 14.75c1.9.6 3.1 2.3 3.5 4.75"/>',
  briefcase:
    '<rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M8.5 7V5.5A1.5 1.5 0 0110 4h4a1.5 1.5 0 011.5 1.5V7"/><path d="M3 12.5h18"/>',
  wifi:
    '<path d="M2.75 9a14 14 0 0118.5 0"/><path d="M6 12.5a9 9 0 0112 0"/><path d="M9.25 16a4.25 4.25 0 015.5 0"/><path d="M12 19.25v.01"/>',
  wallet:
    '<path d="M4 7.5V18a2 2 0 002 2h13a1 1 0 001-1v-3"/><path d="M4 7.5A2.5 2.5 0 016.5 5H17v2.5"/><path d="M4 7.5h15a1 1 0 011 1V12"/><path d="M20.5 12H16a2 2 0 000 4h4.5z"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
  [key: string]: unknown;
}

const { name, size = 20, label, class: className, strokeWidth = 1.75, ...rest } = Astro.props;
const body = ICONS[name] ?? '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={body}
/>

<style>
  .icon {
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }
</style>
