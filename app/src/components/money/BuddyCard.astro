---
/**
 * One Local Buddy in the marketplace grid. Data attributes drive client-side filtering.
 * The whole card is clickable through the stretched name link; it stays a single link for screen readers.
 */
import type { Buddy } from '../../types/contracts';
import Avatar from '../ui/Avatar.astro';
import Rating from '../ui/Rating.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { cityLabel } from './plans';

interface Props {
  buddy: Buddy;
  headingLevel?: 2 | 3;
}
const { buddy, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const name = buddy.displayName.replace(/\s*\(demo\)\s*$/i, '');
---

<li
  class="bcard"
  data-buddy
  data-city={buddy.city}
  data-services={buddy.services.join('|')}
  data-languages={buddy.languages.join('|')}
  data-price={buddy.priceUsd}
  data-rating={buddy.rating}
>
  <div class="bcard__top">
    <Avatar name={name} src={buddy.avatarUrl ?? `/images/buddies/${buddy.id}.svg`} size="lg" />
    <div class="bcard__id">
      <H class="bcard__name"><a href={`/buddies/${buddy.id}`} class="bcard__link">{name}</a></H>
      <p class="bcard__city"><Icon name="map-pin" size={16} />{cityLabel(buddy.city)}</p>
    </div>
    <Badge variant="demo" class="bcard__demo" />
  </div>
  <Rating value={buddy.rating} count={buddy.sessions} />
  <p class="bcard__langs"><Icon name="globe" size={16} />{buddy.languages.join(', ')}</p>
  <ul class="bcard__services" aria-label="Services">
    {buddy.services.slice(0, 3).map((s) => <li>{s}</li>)}
  </ul>
  <p class="bcard__price">
    <strong>${buddy.priceUsd}</strong><span> / 60 min</span>
    <span class="bcard__cta" aria-hidden="true">View profile <Icon name="arrow-right" size={16} /></span>
  </p>
</li>

<style>
  .bcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .bcard:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-raise);
  }
  .bcard:active {
    transform: scale(0.99);
  }
  .bcard:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .bcard__top {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .bcard__id {
    flex: 1;
    min-width: 0;
  }
  .bcard__name {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }
  .bcard__link {
    color: var(--color-ink);
    text-decoration: none;
  }
  .bcard__link:focus-visible {
    outline: none;
  }
  .bcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .bcard__city,
  .bcard__langs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  :global(.bcard__demo) {
    align-self: flex-start;
  }
  .bcard__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .bcard__services li {
    padding: 0.25em 0.75em;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .bcard__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    margin-top: auto;
    font-variant-numeric: tabular-nums;
  }
  .bcard__price strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .bcard__price span {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }
  .bcard__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    color: var(--color-brand) !important;
    font-weight: var(--weight-semibold);
  }
  .bcard:hover .bcard__cta :global(svg) {
    transform: translateX(3px);
  }
  .bcard__cta :global(svg) {
    transition: transform var(--duration-base) var(--ease-out);
  }
</style>
