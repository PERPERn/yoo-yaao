---
import Button from '../ui/Button.astro';
import SourceTag from '../ui/SourceTag.astro';
import Icon from '../ui/Icon.astro';
import { visaBySlug, VERIFIED_ON } from '../../data/visas';

const exempt = visaBySlug('visa-exempt');
const dtv = visaBySlug('dtv');
const exemptSource = exempt.sources.find((s) => s.tier === 'primary') ?? exempt.sources[0];
const fee = new Intl.NumberFormat('en-US').format(dtv.cost?.amount ?? 0);
---

<section class="scene scene--problem" data-scene="problem" aria-labelledby="problem-title">
  <div class="container problem">
    <div class="problem__head stack" data-reveal>
      <h2 id="problem-title" class="display-6xl problem__title">The rules keep changing.</h2>
      <p class="lead">Thai visa rules changed at least four times since 2024: the DTV and 60-day visa-free (July 2024), the TDAC online arrival card (May 2025), new DTV documents (31 Aug 2026) and 30-day visa-free (15 Sep 2026). Most blogs haven't caught up.</p>
      <div>
        <Button href="/visas/visa-exempt" variant="secondary" iconRight="arrow-right">Read what changed</Button>
      </div>
    </div>

    <ul class="pains" role="list" data-pains>
      <li class="pain pain--alert">
        <p class="pain__big tabular">
          <span data-count-to={exempt.stay.perEntryDays} data-count-from="60">{exempt.stay.perEntryDays}</span>
          <span class="pain__unit">days</span>
        </p>
        <h3 class="pain__title">Visa-free is now 30 days</h3>
        <p class="pain__body">Down from 60 days for most passports since 15 Sep 2026.</p>
        {exemptSource && <SourceTag source={exemptSource} verifiedAt={VERIFIED_ON} compact />}
      </li>
      <li class="pain">
        <Icon name="alert" size={28} class="pain__icon" />
        <h3 class="pain__title">Blogs disagree</h3>
        <p class="pain__body">One DTV, different prices: {fee} THB at one embassy, €350 at another. We show both, with sources.</p>
      </li>
      <li class="pain">
        <Icon name="calendar" size={28} class="pain__icon" />
        <h3 class="pain__title">90-day reports are easy to forget</h3>
        <p class="pain__body">Stay 90 days in a row and you must report your address. Late filing usually costs 2,000 THB.</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .scene--problem {
    padding-block: var(--space-section);
  }
  .problem {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 60rem) {
    .problem {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .problem__title {
    font-size: var(--text-5xl);
  }
  .pains {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .pain {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-2);
  }
  .pain--alert {
    background: var(--color-warning-tint);
  }
  .pain__big {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--color-warning);
    margin: 0;
  }
  .pain__unit {
    font-size: var(--text-2xl);
  }
  .pain__title {
    font-size: var(--text-xl);
    margin: 0;
  }
  .pain__body {
    margin: 0;
    color: var(--color-ink-2);
  }
  .pain :global(.pain__icon) {
    color: var(--color-brand);
  }
  /* Story mode (>=640px, motion OK): headline left, the cards rise in on the right. */
  @media (min-width: 60rem) {
    :global(html.home-story) .scene--problem {
      min-height: 100svh;
      display: grid;
      align-content: center;
      padding-block: calc(var(--header-h) + var(--space-6)) var(--space-8);
    }
    :global(html.home-story) .problem {
      gap: var(--space-8);
    }
    :global(html.home-story) .problem__title {
      font-size: var(--text-4xl);
    }
    :global(html.home-story) .pains {
      gap: var(--space-3);
    }
    :global(html.home-story) .pain {
      padding: var(--space-5);
      box-shadow: var(--shadow-card-stack);
    }
    :global(html.home-story) .pain__big {
      font-size: var(--text-4xl);
    }
  }
</style>
