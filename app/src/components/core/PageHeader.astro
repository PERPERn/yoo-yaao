---
/**
 * Top of every Frontend-A page: optional breadcrumbs, the page's single <h1>, a lead line,
 * and an optional `aside` slot that sits to the right on wide screens (a key figure, a picker…).
 * Default slot renders under the lead (chips, actions).
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  tone?: 'default' | 'tint';
  class?: string;
}
const { title, lead, crumbs, tone = 'default', class: className } = Astro.props;
const hasAside = Astro.slots.has('aside');
const hasArt = Astro.slots.has('art');
---

<header class:list={['phead theme-night', hasArt && 'phead--art', tone === 'tint' && 'section--tint', className]}>
  <div class="container">
    {crumbs && <Breadcrumbs items={crumbs} class="phead__crumbs" />}
    <div class:list={['phead__grid', hasAside && 'phead__grid--aside']}>
      <div class="phead__text">
        <h1 class="phead__title" data-intro>{title}</h1>
        {lead && <p class="phead__lead">{lead}</p>}
        <div class="phead__extra" data-intro><slot /></div>
      </div>
      {hasAside && <div class="phead__aside" data-intro><slot name="aside" /></div>}
    </div>
  </div>
  {hasArt && <div class="phead__art"><slot name="art" /></div>}
</header>

<style>
  .phead:has(+ :global(.section--tint)) {
    margin-bottom: 0 !important;
  }
  .phead {
    position: relative;
    isolation: isolate;
    background: var(--lacquer) url('/media/stage/plaster.webp') center / cover;
    color: var(--color-ink);
    --color-ink-2: #c6d8d3;
    --color-focus: var(--night-accent);
    border-bottom: 3px solid var(--night-accent);
    margin-bottom: var(--space-10);
    padding-block: var(--space-8) var(--space-12);
  }
  .phead__crumbs {
    margin-bottom: var(--space-6);
  }
  .phead__grid {
    display: grid;
    gap: var(--space-8);
    align-items: end;
  }
  @media (min-width: 60rem) {
    .phead {
      padding-block: var(--space-10) var(--space-16);
    }
    .phead__grid--aside {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-16);
    }
  }
  .phead__title {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    max-width: 18ch;
  }
  .phead__lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: #d4e2dd;
    max-width: 58ch;
    text-wrap: pretty;
  }
  /* Optional render on the right edge (a lit niche), bleeding into the band */
  .phead__art {
    display: none;
  }
  @media (min-width: 60rem) {
    .phead--art {
      min-height: 27rem;
      display: grid;
      align-content: center;
    }
    .phead--art .phead__text {
      max-width: 38rem;
    }
    .phead__art {
      display: block;
      position: absolute;
      inset: 0 0 0 auto;
      width: 58%;
      z-index: -1;
      mask-image: linear-gradient(90deg, transparent, #000 38%);
    }
    .phead__art :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 78% 62%;
    }
  }
  .phead__extra:empty {
    display: none;
  }
  .phead__extra {
    margin-top: var(--space-6);
  }
</style>
