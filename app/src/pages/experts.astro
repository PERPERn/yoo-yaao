---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Field from '../components/ui/Field.astro';
import Button from '../components/ui/Button.astro';
import Callout from '../components/ui/Callout.astro';
import Steps from '../components/ui/Steps.astro';
import Icon from '../components/ui/Icon.astro';
import Accordion from '../components/ui/Accordion.astro';
import '../components/money/money.css';
import { SITE } from '../config/site';
import { visas } from '../data/visas';
import { COUNTRIES } from '../data/finder';

const visaOptions = [...visas.map((v) => ({ value: v.slug, label: v.name })), { value: 'not-sure', label: 'Not sure yet' }];
const countryOptions = [...COUNTRIES].sort((a, b) => a.name.localeCompare(b.name)).map((c) => ({ value: c.code, label: c.name }));

const faq = [
  {
    question: 'What does it cost?',
    answer:
      'Asking is free and you are under no obligation. If you hire the agency, they quote their own fee before any work starts. We may receive a referral fee from partner agents; it never changes what you pay.',
  },
  {
    question: 'Who are the agents?',
    answer:
      'Thai visa agencies and law firms that hold a valid licence or registration, which we check before they can receive requests.',
  },
  {
    question: 'What happens to my details?',
    answer: `We share your request with at most 2 partner agencies and nobody else. Ask us to delete it at any time: <a href="mailto:${SITE.supportEmail}">${SITE.supportEmail}</a>. See our <a href="/legal#privacy">privacy notice</a>.`,
  },
];
---

<Base
  title="Get expert help"
  description="Complex visa case? Tell us about it and a licensed Thai visa agency replies within 1 business day. Free to ask."
>
  <div class="container m-hero">
    <h1 data-intro>Get help from a licensed visa expert</h1>
    <p class="lead" data-intro>
      Free to ask. We only refer you to licensed agencies, and we never file visas ourselves.
    </p>
  </div>

  <section class="section ex" aria-labelledby="form-title">
    <div class="container split" style="align-items: start">
      <div class="stack" style="--stack-gap: var(--space-6)" data-reveal>
        <h2 id="steps-title">How it works</h2>
        <Steps
          items={[
            { title: 'Tell us your case', body: 'Your visa, passport and timeline, in a few sentences.' },
            { title: 'A matched agent replies within 1 business day', body: 'By email, with what they need from you and their fee.' },
            { title: 'You decide', body: 'Hire them or not. There is no obligation.' },
          ]}
        />
        <Callout tone="info" title="When an expert is worth it">
          A previous overstay or refusal, income that is hard to document, a family or business visa, or a deadline
          that is days away.
        </Callout>
        <p class="small muted disclosure">
          <Icon name="wallet" size={18} /> We may receive a referral fee from partner agents. It never changes what you pay.
        </p>
      </div>

      <div class="form-panel" data-reveal="right">
        <form class="form" data-lead novalidate>
          <h2 id="form-title" class="form-title">Tell us about your case</h2>
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this empty</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-row">
            <Input name="name" id="e-name" label="Your name" autocomplete="name" required />
            <Input name="email" id="e-email" type="email" label="Email" autocomplete="email" required />
          </div>
          <Select name="visa" id="e-visa" label="Which visa are you considering?" placeholder="Choose a visa" options={visaOptions} required />
          <Select name="nationality" id="e-nat" label="Passport country" placeholder="Choose a country" options={countryOptions} required />
          <Field id="e-time" label="When do you want to apply?" group required>
            <div class="chips" data-group="e-time">
              {['Within 1 month', '1–3 months', 'Just researching'].map((t) => (
                <label class="chip"><input type="radio" name="timeline" value={t} /><span>{t}</span></label>
              ))}
            </div>
          </Field>
          <Input
            name="message"
            id="e-msg"
            label="Tell us about your case"
            hint="e.g. freelancer with clients in the EU, want DTV, previous overstay of 3 days"
            multiline
            rows={5}
            maxlength="1000"
            required
          />
          <Field id="e-consent" label="Consent" group hideLabel>
            <label class="choice" data-group="e-consent">
              <input type="checkbox" name="consent" value="yes" />
              <span>I agree that {SITE.name} shares my request with up to 2 licensed partner agents.</span>
            </label>
          </Field>
          <div data-form-error hidden>
            <Callout tone="danger" live title="Couldn't send your request"><span data-form-error-text></span></Callout>
          </div>
          <Button type="submit" size="lg" block>Get matched with an expert</Button>
          <p class="form-foot">Free to ask. No obligation.</p>
        </form>

        <div class="done" data-done hidden tabindex="-1">
          <span class="done__mark"><Icon name="check" size={28} strokeWidth={2.25} /></span>
          <h2>Request sent</h2>
          <p>A licensed agent will email you within 1 business day. Reference <strong data-ref class="tabular"></strong>.</p>
          <p class="small muted">You can also chat with your agency once they're assigned. Sign in with the same email to open Messages.</p>
          <div class="cluster">
            <Button href="/messages" iconRight="arrow-right" data-chat-link>Message this agency</Button>
            <Button href="/visas" variant="secondary">Read the visa guides</Button>
            <Button href="/tools" variant="ghost">Open Stay Tools</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Section
    id="agencies"
    title="Or message an agency directly"
    lead="Licensed agencies we've checked. Ratings come from nomads who confirmed their work was delivered."
  >
    <p class="ag-demo" data-ag-demo hidden><Icon name="info" size={16} /> Demo view — sample data</p>
    <ul class="ag-list" data-ag-list aria-busy="true">
      <li class="ag-card ag-card--skel" aria-hidden="true"></li>
      <li class="ag-card ag-card--skel" aria-hidden="true"></li>
    </ul>
    <p class="ag-err" data-ag-err role="alert"></p>
    <template data-ag-tpl>
      <li class="ag-card">
        <div class="ag-card__top">
          <h3 class="ag-card__name" data-name></h3>
          <span class="ag-verified"><Icon name="shield" size={14} /> Verified</span>
        </div>
        <p class="ag-card__meta" data-meta></p>
        <p class="ag-stars" data-stars></p>
        <Button size="sm" iconRight="arrow-right" data-message>Message</Button>
      </li>
    </template>
  </Section>

  <Section tone="tint" width="narrow" title="Questions about expert help">
    <Accordion items={faq} />
  </Section>
</Base>

<style>
  .ex {
    padding-top: var(--space-6);
  }
  .form-title {
    font-size: var(--text-2xl);
  }
  .form fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .ag-demo {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-text);
  }
  .ag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .ag-list :global(.ag-card) {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    min-width: 0;
  }
  .ag-list :global(.ag-card--skel) {
    min-height: 10rem;
    background: var(--color-surface-2);
  }
  .ag-list :global(.ag-card__top) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
  }
  .ag-list :global(.ag-card__name) {
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }
  .ag-list :global(.ag-verified) {
    display: inline-flex;
    gap: 0.25em;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-success);
  }
  .ag-list :global(.ag-card__meta) {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .ag-list :global(.ag-stars) {
    display: inline-flex;
    gap: 0.35em;
    align-items: baseline;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-2);
  }
  .ag-list :global(.ag-stars__icons) {
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }
  .ag-list :global(.ag-stars__n) {
    color: var(--color-ink-2);
  }
  .ag-err {
    margin-top: var(--space-3);
    color: var(--color-danger);
    font-size: var(--text-sm);
  }
  .ag-err:empty {
    display: none;
  }
  .disclosure {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
</style>

<script>
  import { initMotion } from '../scripts/motion';
  import {
    applyValidation,
    liveValidate,
    val,
    checkedValues,
    EMAIL_RE,
    setBusy,
    postJson,
    formErrorMessage,
    shortRef,
    type Validator,
  } from '../components/money/client';
  import { agentRatings, listAgents, type AgentRating, type OpsAgent } from '../lib/ops';
  import { getSession } from '../lib/supabase';
  import { DEMO_AGENTS, DEMO_AGENT_RATINGS, DEMO_AGENT_THREAD } from '../data/demo-ops';
  import { ratingLabel } from '../components/chat/delivery';
  import { cityLabel } from '../components/money/plans';

  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

  /** Agency cards: verified agents from the DB, or sample ones (labelled) when there are none. */
  async function initAgencies() {
    const ul = document.querySelector<HTMLUListElement>('[data-ag-list]')!;
    const tpl = document.querySelector<HTMLTemplateElement>('[data-ag-tpl]')!;
    const err = document.querySelector<HTMLElement>('[data-ag-err]')!;
    const [a, r, session] = await Promise.all([listAgents(), agentRatings(), getSession().catch(() => null)]);
    let agents: OpsAgent[] = (a.data ?? []).filter((x) => x.verified);
    let ratings: AgentRating[] = r.data ?? [];
    const demo = !agents.length;
    if (demo) {
      agents = DEMO_AGENTS.filter((x) => x.verified);
      ratings = DEMO_AGENT_RATINGS;
    }
    document.querySelector<HTMLElement>('[data-ag-demo]')!.hidden = !demo;
    const byId = new Map(ratings.map((x) => [x.agent_id, x]));

    async function contact(agent: OpsAgent, btn: HTMLButtonElement) {
      err.textContent = '';
      const sample = !UUID_RE.test(agent.id);
      // Signed out + sample agency: open its sample chat, nothing is written.
      if (!session && sample) return void (location.href = `/messages?lead=${encodeURIComponent(DEMO_AGENT_THREAD[agent.id] ?? '')}`);
      if (!session) return void (location.href = `/account?next=${encodeURIComponent(`/experts?contact=${agent.id}#agencies`)}`);
      const email = session.user.email ?? '';
      const restore = setBusy(btn, 'Opening chat…');
      const res = await postJson('/api/lead', {
        name: email.split('@')[0].slice(0, 120) || 'Nomad',
        email,
        source: 'experts:message',
        message: `Hi ${agent.name}, I'd like to ask about my visa.`,
        agentId: sample ? null : agent.id, // sample agency: our team picks a real one
      });
      if (!res.ok || typeof res.data.id !== 'string') {
        restore();
        err.textContent = res.ok ? 'Something went wrong. Try again.' : formErrorMessage(res);
        return;
      }
      location.href = `/messages?lead=${encodeURIComponent(res.data.id)}`;
    }

    ul.replaceChildren(
      ...agents.map((ag) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        li.querySelector('[data-name]')!.textContent = ag.name;
        li.querySelector('[data-meta]')!.textContent = [ag.company, ag.cities.map(cityLabel).join(', ')].filter(Boolean).join(' · ');
        const stars = li.querySelector<HTMLElement>('[data-stars]')!;
        const rt = byId.get(ag.id);
        if (rt) {
          const full = Math.round(rt.avg_rating);
          const icons = document.createElement('span');
          icons.className = 'ag-stars__icons';
          icons.textContent = '★'.repeat(full) + '☆'.repeat(5 - full);
          icons.setAttribute('aria-hidden', 'true');
          const val = document.createElement('strong');
          val.textContent = rt.avg_rating.toFixed(1);
          const n = document.createElement('span');
          n.className = 'ag-stars__n';
          n.textContent = `(${rt.review_count})`;
          n.setAttribute('aria-hidden', 'true');
          val.setAttribute('aria-hidden', 'true');
          const sr = document.createElement('span');
          sr.className = 'sr-only';
          sr.textContent = ratingLabel(rt);
          stars.append(icons, val, n, sr);
        } else stars.textContent = 'No reviews yet';
        const btn = li.querySelector<HTMLButtonElement>('[data-message]')!;
        btn.setAttribute('aria-label', `Message ${ag.name}`);
        btn.addEventListener('click', () => contact(ag, btn));
        return li;
      }),
    );
    ul.removeAttribute('aria-busy');

    // Back from sign-in with ?contact=<agent id>: finish what the user started.
    const want = new URLSearchParams(location.search).get('contact');
    if (want && session) {
      const url = new URL(location.href);
      url.searchParams.delete('contact');
      history.replaceState(null, '', url); // a reload must not create a second lead
      const ag = agents.find((x) => x.id === want);
      const btn = [...ul.querySelectorAll<HTMLButtonElement>('[data-message]')][agents.indexOf(ag!)];
      if (ag && btn) void contact(ag, btn);
    }
  }

  initMotion();
  void initAgencies();
  const form = document.querySelector<HTMLFormElement>('[data-lead]')!;
  const errBox = form.querySelector<HTMLElement>('[data-form-error]')!;
  const errText = form.querySelector<HTMLElement>('[data-form-error-text]')!;

  // Prefill the visa from ?visa=dtv (finder results and visa guides link here).
  const visa = new URLSearchParams(location.search).get('visa');
  const visaSelect = form.querySelector<HTMLSelectElement>('#e-visa');
  if (visa && visaSelect && Array.from(visaSelect.options).some((o) => o.value === visa)) visaSelect.value = visa;

  const validate: Validator = (f) => {
    const e: Record<string, string> = {};
    if (!val(f, 'name')) e['e-name'] = 'Enter your name.';
    const email = val(f, 'email');
    if (!email) e['e-email'] = 'Enter an email address.';
    else if (!EMAIL_RE.test(email)) e['e-email'] = "That doesn't look like an email. Check for typos.";
    if (!val(f, 'visa')) e['e-visa'] = 'Choose a visa, or "Not sure yet".';
    if (!val(f, 'nationality')) e['e-nat'] = 'Choose your passport country.';
    if (!val(f, 'timeline')) e['e-time'] = 'Choose when you want to apply.';
    const m = val(f, 'message').length;
    if (m < 20) e['e-msg'] = `Add a little more detail (${20 - m} more characters).`;
    else if (m > 1000) e['e-msg'] = 'Keep it under 1000 characters.';
    if (!checkedValues(f, 'consent').length) e['e-consent'] = 'We need your OK to share your request with an agent.';
    return e;
  };
  liveValidate(form, validate);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errBox.hidden = true;
    if (!applyValidation(form, validate)) return;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const restore = setBusy(btn, 'Sending…');
    const ref = shortRef();
    const r = await postJson('/api/lead', {
      name: val(form, 'name'),
      email: val(form, 'email'),
      nationality: val(form, 'nationality'),
      visaSlug: val(form, 'visa'),
      message: `[${ref}] Timeline: ${val(form, 'timeline')}\n\n${val(form, 'message')}`,
      source: 'experts',
      website: val(form, 'website'),
    });
    restore();
    if (!r.ok) {
      errText.textContent = formErrorMessage(r);
      errBox.hidden = false;
      return;
    }
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    done.querySelector('[data-ref]')!.textContent = `#${ref}`;
    if (typeof r.data.id === 'string') done.querySelector<HTMLAnchorElement>('[data-chat-link]')!.href = `/messages?lead=${encodeURIComponent(r.data.id)}`;
    form.hidden = true;
    done.hidden = false;
    done.focus();
  });
</script>
