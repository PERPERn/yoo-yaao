---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Chat from '../components/chat/Chat.astro';
---

<Base title="Messages" description="Your conversations with licensed visa agencies on Yoo Yaao." noindex>
  <div class="container msgs">
    <div class="msgs-demo" data-msgs-demo role="status" hidden>
      <span class="msgs-demo__tag"><Icon name="info" size={18} /> Demo view — sample data</span>
      <p class="msgs-demo__text">You're not signed in, so this shows sample chats. Try sending a message; nothing is saved.</p>
      <Button href="/account?next=/messages" variant="secondary" size="sm" iconRight="arrow-right">Sign in to see yours</Button>
    </div>

    <header class="msgs-head">
      <h1 class="msgs-title">Messages</h1>
      <p class="msgs-lede">Talk to the licensed agency matched to your visa request. Sign in with the email you used on the request.</p>
    </header>

    <Chat
      side="customer"
      emptyHref="/experts"
      emptyLabel="Ask a visa expert"
      emptyText="Send a request to a licensed agency and your conversation shows up here."
    />
  </div>
</Base>

<style>
  .msgs {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(var(--space-6), 4vw, var(--space-12)) var(--space-section);
  }
  .msgs-title {
    font-size: var(--text-3xl);
  }
  .msgs-lede {
    color: var(--color-ink-2);
    max-width: 60ch;
  }
  .msgs-demo {
    display: grid;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-inverse-bg);
    color: var(--color-inverse-ink);
    border: 2px dashed var(--color-accent);
    --color-focus: var(--color-accent);
  }
  .msgs-demo__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    color: var(--color-accent);
  }
  .msgs-demo__text {
    font-size: var(--text-sm);
    opacity: 0.85;
  }
  /* Secondary button on the dark banner (Button styles assume a light surface). */
  .msgs-demo :global(.btn.btn--secondary) {
    --btn-fg: var(--color-inverse-ink);
    --btn-border: var(--color-accent);
    --btn-bg-hover: rgb(255 255 255 / 0.1);
  }
  @media (min-width: 48rem) {
    .msgs-demo {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>

<script>
  import { initChat } from '../components/chat/chat';
  import { getSession } from '../lib/supabase';

  getSession()
    .catch(() => null)
    .then((session) => {
      const demo = !session;
      const banner = document.querySelector<HTMLElement>('[data-msgs-demo]')!;
      banner.hidden = !demo;
      // Keep ?lead=<id> (deep link from /experts) through the sign-in round trip.
      banner.querySelector<HTMLAnchorElement>('a')!.href = `/account?next=${encodeURIComponent(location.pathname + location.search)}`;
      initChat(document.querySelector<HTMLElement>('[data-chat]')!, { demo });
    });
</script>
