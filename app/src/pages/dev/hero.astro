---
// Dev-only test page for the 3D hero (hero3d.ts) and data-attribute motion (motion.ts).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Hero 3D test</title>
    <link rel="preload" href="/models/hero-fallback.webp" as="image" type="image/webp" />
    <style>
      :root { color-scheme: light; --sand: #f6efe2; --ink: #17323b; --teal: #1e7f7c; --gold: #d9a441; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, sans-serif; background: var(--sand); color: var(--ink); }
      header { position: sticky; top: 0; z-index: 2; padding: 14px 20px; background: rgba(246,239,226,.9); backdrop-filter: blur(6px); border-bottom: 1px solid #e6dcc8; }
      .hero { display: grid; grid-template-columns: 1fr; gap: 16px; padding: 24px 16px 0; max-width: 1200px; margin: 0 auto; align-items: center; min-height: 88vh; }
      @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1.1fr; } }
      .hero h1 { font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.05; margin: 0 0 12px; }
      .hero p { font-size: 1.15rem; max-width: 34ch; }
      .stage { aspect-ratio: 4 / 3; width: 100%; }
      .cta { display: inline-block; padding: 12px 20px; border-radius: 999px; background: var(--teal); color: #fff; text-decoration: none; }
      section { max-width: 1000px; margin: 0 auto; padding: 72px 16px; }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
      .card { background: #fffaf1; border: 1px solid #eadfca; border-radius: 16px; padding: 20px; }
      .stat { font-size: 2.6rem; font-weight: 700; color: var(--teal); }
      .blob { width: 120px; height: 120px; border-radius: 50%; background: var(--gold); opacity: .5; }
    </style>
  </head>
  <body>
    <header data-intro="header"><strong>Visa dev</strong> · hero3d test</header>

    <div class="hero">
      <div>
        <p data-intro style="text-transform:uppercase;letter-spacing:.12em;font-size:.8rem;color:var(--teal)">Thailand long-stay</p>
        <h1 data-intro>Stay in Thailand longer, and legally.</h1>
        <p data-intro>Find the right visa in two minutes, then keep every deadline on track.</p>
        <a class="cta" href="#more" data-intro>Find my visa</a>
      </div>
      <div class="stage" data-hero-3d></div>
    </div>

    <section id="more">
      <h2 data-reveal>Reveal block</h2>
      <p data-reveal data-reveal-delay="0.1">This paragraph fades and rises in once it enters the viewport.</p>
      <div class="cards" data-reveal-stagger>
        <div class="card"><div class="stat" data-count-to="180">180</div>days per DTV entry</div>
        <div class="card"><div class="stat" data-count-to="10000" data-count-prefix="฿">฿10,000</div>DTV fee</div>
        <div class="card"><div class="stat" data-count-to="5" data-count-suffix=" yrs">5 yrs</div>DTV validity</div>
      </div>
    </section>

    <section>
      <div class="blob" data-parallax="0.3"></div>
      <h2 data-reveal="left">From the left</h2>
      <p data-reveal="right">From the right</p>
      <p data-reveal="scale">Scaled in</p>
    </section>
    <section style="min-height:60vh"><p data-reveal="fade">End of page.</p></section>

    <script>
      import "../../scripts/hero3d";
      import { initMotion } from "../../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
