---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
import VisaGallery from '../components/stage/VisaGallery.astro';
import CityMap from '../components/stage/CityMap.astro';
import HeroStage from '../components/ui/HeroStage.astro';
import SceneProblem from '../components/home/SceneProblem.astro';
import SceneBlueprint from '../components/home/SceneBlueprint.astro';
import SceneWhy from '../components/home/SceneWhy.astro';
import SceneBuddies from '../components/home/SceneBuddies.astro';
import SceneDemo from '../components/home/SceneDemo.astro';
import SceneTrust from '../components/home/SceneTrust.astro';
import ScenePlans from '../components/home/ScenePlans.astro';
import SceneFaq from '../components/home/SceneFaq.astro';
import SceneFinale from '../components/home/SceneFinale.astro';
---

<Base title={SITE.name} description={SITE.description} over>
  <link slot="head" rel="preload" href="/media/stage/wall.webp" as="image" type="image/webp" media="(min-width: 60rem) and (min-aspect-ratio: 5/4)" />
  <div class="home">
    <HeroStage ratio="4 / 3" data-hero-story label="An open passport with a gold visa stamp" />
    <VisaGallery />
    <SceneProblem />
    <SceneBlueprint />
    <CityMap />
    <SceneWhy />
    <SceneBuddies />
    <SceneDemo />
    <SceneTrust />
    <ScenePlans />
    <SceneFaq />
    <SceneFinale />
  </div>
</Base>

<style is:global>
  /* One WebGL canvas for the whole story: once hero3d is ready in story mode (>=640px, motion OK),
     the hero stage becomes a fixed, transparent, click-through layer above the scenes. */
  html .hero-stage[data-story='on'] {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100svh;
    aspect-ratio: auto;
    border-radius: 0;
    background: transparent;
    pointer-events: none;
    z-index: var(--z-stage);
  }
  /* Until the 3D story is ready (and on phones, where it never runs) the stage stays out of sight. */
  html .home > .hero-stage:not([data-story='on']) {
    position: absolute;
    width: 100%;
    height: 100svh;
    visibility: hidden;
    pointer-events: none;
    z-index: -1;
  }
  html .hero-stage[data-story='on'] :is(.hero3d-poster, .hero-stage__fallback) {
    display: none;
  }
  /* The scene snap tweens the scroll itself; CSS smooth scrolling would fight every frame. */
  html.home-story {
    scroll-behavior: auto;
  }
  .home {
    overflow-x: clip;
  }
</style>

<script>
  import '../scripts/home-scroll';
</script>
