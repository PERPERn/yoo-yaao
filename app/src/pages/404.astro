---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { visas } from '../data/visas';
---

<Base title="Page not found" description="This page took a wrong turn." noindex>
  <section class="nf">
    <div class="container nf__grid">
      <div>
        <p class="nf__code" aria-hidden="true">404</p>
        <h1 class="nf__title">This page took a wrong turn.</h1>
        <p class="nf__lead">The link may be old, or the address mistyped. These will get you back on track:</p>
        <div class="nf__actions">
          <Button href="/finder" iconRight="arrow-right">Visa Finder</Button>
          <Button href="/visas" variant="secondary">All visas</Button>
          <Button href="/" variant="ghost">Home</Button>
        </div>
      </div>
      <nav class="nf__visas" aria-labelledby="nf-visas">
        <h2 id="nf-visas">Looking for a visa guide?</h2>
        <ul>
          {
            visas.map((v) => (
              <li>
                <a href={`/visas/${v.slug}`}>
                  <span>{v.name}</span>
                  <Icon name="arrow-right" size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: var(--space-16) var(--space-section);
  }
  .nf__grid {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 60rem) {
    .nf__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .nf__code {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    font-weight: var(--weight-bold);
    line-height: 0.9;
    letter-spacing: var(--tracking-giant);
    color: var(--color-brand-tint);
  }
  .nf__title {
    margin-top: var(--space-4);
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    max-width: 16ch;
    text-wrap: balance;
  }
  .nf__lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: 48ch;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .nf__visas {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }
  .nf__visas h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .nf__visas ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }
  .nf__visas a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 3rem;
    padding-block: var(--space-2);
    color: var(--color-ink);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }
  .nf__visas a:hover {
    color: var(--color-brand);
  }
</style>
